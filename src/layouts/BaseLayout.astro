---
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "My Blog" } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <div class="layout">
      <Sidebar class="sidebar" />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
  </body>
  <style>
    .layout {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 100vh;
    }

    main {
      min-width: 0;
      padding: 1.5rem;
    }

    @media (min-width: 769px) {
      .layout {
        grid-template-columns: 280px minmax(0, 1fr);
        align-items: start;
      }

      .layout > :global(*:first-child),
      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }

      main {
        padding: 3rem 1rem;
      }
    }
  </style>
</html>
