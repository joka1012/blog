---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";

const posts = await getCollection("blog");

console.log("Anzahl der Blogposts:", posts.length);
console.log("Blogposts:", posts);

const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
  <main>
    <h1>You and me, let's learn creative coding together</h1>

    <p>
      Experiments, notes and discoveries at the intersection of code, design and
      interaction.
    </p>

    <section class="posts">
      {sortedPosts.map((post) => <ArticleCard post={post} />)}
    </section>
  </main>
</BaseLayout>
